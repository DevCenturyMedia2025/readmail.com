# ReadMail environment example
# Copiar este archivo como .env y reemplazar los valores placeholder.
# Nunca subir .env real, tokens, credentials.json ni carpetas accounts/ al repositorio.

# Ambiente
APP_ENV=staging
DRY_RUN=true
LOG_LEVEL=DEBUG

# Google Cloud / Gmail PubSub
GCP_PROJECT_ID=
PUBSUB_SUBSCRIPTION=
PUBSUB_SUBSCRIPTION_ID=
PUBSUB_TOPIC_FULL=
GMAIL_LABEL_IDS=INBOX
GMAIL_WATCH_STATE_FILE=gmail_watch_state.json

# Modo seguro de pruebas: escucha solo la etiqueta indicada e ignora INBOX.
MODO_PRUEBAS=false
ETIQUETA_PRUEBAS=pruebas

# Completa NIT faltantes en Administrativas/CajaMenor. Mantener apagado hasta re-autorizar OAuth.
AUTO_FILL_NIT_ENABLED=false

# Evita responder correos antiguos ya gestionados manualmente (se ignora en MODO_PRUEBAS).
LIMITE_ANTIGUEDAD_ENABLED=true
MAX_DIAS_ANTIGUEDAD=5

# Alertas de errores técnicos por WhatsApp (CallMeBot). No se usa para rechazos ni aprobaciones.
WHATSAPP_ALERT_ENABLED=false
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
WHATSAPP_COOLDOWN_MIN=15

# Google Sheets client catalog
CLIENT_SHEET_ID=
CLIENT_SHEET_RANGE=Clientes!A:Z
CLIENT_LOOKUP_RANGE=Clientes!A:Z
ACTIVE_VALUES=activo,active,si,yes,1,true

# Compatibilidad futura / nombres alternos
SHEET_ID=
SHEET_RANGE=Clientes!A:Z

# Gmail account mode
# Leave empty for a single OAuth account using ./token.json.
# For multiple accounts, use comma-separated emails and authorize each one.
GMAIL_ACCOUNTS=
ACCOUNTS_DIR=accounts

# Token auth alerts
# Destination that receives alerts when an account token expires on the server.
TOKEN_ALERT_EMAIL=
# Set true only on an authorized PC where browser OAuth can run.
INTERACTIVE_AUTH=false
# Minimum hours before repeating the token alert for the same failed account.
TOKEN_ALERT_COOLDOWN_HOURS=12

# Labels
LABEL_ADMIN_NAME=ADMINISTRATIVA
LABEL_REVIEW_NAME=REVISIÓN MANUAL
LABEL_NOTE_CREDIT_NAME=NOTA DE CRÉDITO
LABEL_APPROVED_NAME=APROBADOS
LABEL_REJECTED_NAME=RECHAZADOS

# Archiving behavior
ARCHIVE_ON_STATUS=true
ARCHIVE_APPROVED=true
ARCHIVE_REJECTED=true
ARCHIVE_ADMIN=true
ARCHIVE_NOTE_CREDIT=true
ARCHIVE_REVIEW=false

# Processing behavior
ONLY_WITH_ATTACHMENTS=true
PROCESSED_CACHE_LIMIT=3000
RADICADO_PREFIX=RAD
RADICADO_PAD=6
RADICADO_RESET_DAILY=true
RADICADO_MAP_LIMIT=10000

# Pub/Sub loop
PUBSUB_PULL_MAX=10
PUBSUB_ACK_DEADLINE_SECONDS=600
IDLE_SLEEP_SEC=1.0
WATCH_RENEW_WINDOW_MS=3600000

# Validation thresholds
MIN_PDF_FACTURA_ELECTRONICA=3
MIN_XML_FACTURA_ELECTRONICA=1
MIN_PDF_CUENTA_COBRO=4

# Destinatario alterno para rechazos de proveedores tecnologicos no-reply.
# Si se habilita, intenta XML -> catalogo de clientes -> buzon interno de fallback.
ALT_RECIPIENT_ENABLED=false
ALT_FALLBACK_EMAIL=

# ZIP safety limits
MAX_ZIP_BYTES=26214400
MAX_ZIP_FILES=250
MAX_ZIP_TOTAL_UNCOMPRESSED=157286400
MAX_ZIP_SINGLE_FILE=26214400
MAX_ZIP_NESTING=2
